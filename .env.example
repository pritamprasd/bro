# ==============================================================================
# BRO AI Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your local environment.
# DO NOT commit your actual .env file to public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Gateway API Keys (Optional if running 100% locally via Ollama)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 2. Remote Telegram Bot Bridge (Optional)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 3. Local Directory Paths & Knowledge Storage
# ------------------------------------------------------------------------------
# Base configuration directory (default: ~/.bro)
BRO_CONFIG_DIR=~/.bro

# Primary markdown memory & state directory (default: ~/ai-memory/bro)
BRO_MEMORY_DIR=~/ai-memory/bro

# Obsidian Vault directory for Hybrid BM25 / RAG indexing (leave blank to disable)
OBSIDIAN_VAULT_DIR=~/obsidian/KnowledgeBase/ai-memory

# ------------------------------------------------------------------------------
# 4. Proactive Background Watchdogs
# ------------------------------------------------------------------------------
# Download organizer auto-sorting directory (default: ~/Downloads)
ORGANIZER_WATCH_DIR=~/Downloads

# Web HUD Host and Port (default: 0.0.0.0:8765)
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8765
